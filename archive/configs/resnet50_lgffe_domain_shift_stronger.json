{
  "seed": 42,
  "notes": "ResNet50 IMAGENET1K_V2 layer4 LGFFE: GRU-based regional attention over 8x8 regions, GAP plus weighted original regional features, concat and two-layer head. Stronger domain shift unchanged except uniform D4 replaces H/V flips; no crop. Partial layer3+layer4, frozen backbone BN, 3 head-only warmup epochs. Ordinary CE; train only, val for evaluation; no test access. Untested training candidate.",
  "data": {
    "raw_dir": "data/raw",
    "image_size": 256,
    "batch_size": 32,
    "num_workers": 2,
    "pin_memory": true,
    "normalization": {
      "mean": [
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225
      ]
    },
    "augmentation": {
      "color_jitter": {
        "p": 0.8,
        "brightness": 0.15,
        "contrast": 0.15,
        "saturation": 0.15,
        "hue": 0.02
      },
      "gamma": {
        "p": 0.25,
        "range": [
          0.85,
          1.15
        ]
      },
      "corruption_probability": 0.65,
      "max_corruptions": 2,
      "gaussian_noise": {
        "p": 0.35,
        "std": [
          0.005,
          0.025
        ]
      },
      "gaussian_blur": {
        "p": 0.25,
        "sigma": [
          0.5,
          2.5
        ]
      },
      "jpeg_compression": {
        "p": 0.25,
        "quality": [
          60,
          95
        ]
      },
      "resolution_degradation": {
        "p": 0.2,
        "scale": [
          0.4,
          1.0
        ]
      },
      "random_d4": true
    },
    "persistent_workers": true,
    "prefetch_factor": 2
  },
  "training": {
    "epochs": 25,
    "log_every": 2,
    "device": "auto",
    "deterministic": true,
    "deterministic_warn_only": true,
    "optimizer": {
      "name": "adamw",
      "lr": 0.0005,
      "backbone_lr": 5e-05,
      "head_lr": 0.0005,
      "weight_decay": 0.001
    },
    "scheduler": {
      "name": "cosine",
      "T_max": 25,
      "eta_min": 1e-06
    },
    "loss": {
      "name": "cross_entropy",
      "label_smoothing": 0.0
    }
  },
  "model": {
    "name": "resnet50_lgffe",
    "pretrained": true,
    "weights": "IMAGENET1K_V2",
    "mode": "partial",
    "head_dropout": 0.3,
    "freeze_bn": true,
    "warmup_epochs": 3,
    "unfreeze_blocks": [
      "layer3",
      "layer4"
    ],
    "lgffe": {
      "gru_hidden_size": 512,
      "head_hidden_size": 512
    }
  },
  "exp_id": "resnet50_lgffe_domain_shift_stronger_001"
}
