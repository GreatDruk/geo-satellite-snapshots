{
  "seed": 42,
  "notes": "Matched 256px CNN augmentation study: geometry; same architecture, optimizer, schedule and seed as other arms; untested hypothesis.",
  "data": {
    "raw_dir": "data/raw",
    "image_size": 256,
    "batch_size": 32,
    "num_workers": 2,
    "pin_memory": true,
    "normalization": {
      "mean": [
        0.5,
        0.5,
        0.5
      ],
      "std": [
        0.5,
        0.5,
        0.5
      ]
    },
    "augmentation": {
      "horizontal_flip": 0.5,
      "vertical_flip": 0.5,
      "random_rotate90": 1.0
    },
    "persistent_workers": true,
    "prefetch_factor": 2
  },
  "training": {
    "epochs": 45,
    "log_every": 5,
    "device": "auto",
    "deterministic": true,
    "optimizer": {
      "name": "adamw",
      "lr": 0.0007,
      "weight_decay": 0.005,
      "betas": [
        0.9,
        0.999
      ]
    },
    "scheduler": {
      "name": "cosine",
      "T_max": 45,
      "eta_min": 5e-06
    },
    "deterministic_warn_only": true
  },
  "model": {
    "name": "cnn",
    "pretrained": false,
    "layers": [
      {
        "type": "conv2d",
        "out_channels": 24,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "max_pool2d",
        "kernel_size": 2
      },
      {
        "type": "conv2d",
        "out_channels": 48,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "conv2d",
        "out_channels": 48,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "max_pool2d",
        "kernel_size": 2
      },
      {
        "type": "conv2d",
        "out_channels": 96,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "conv2d",
        "out_channels": 96,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "max_pool2d",
        "kernel_size": 2
      },
      {
        "type": "conv2d",
        "out_channels": 192,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "max_pool2d",
        "kernel_size": 2
      },
      {
        "type": "adaptive_avg_pool2d",
        "output_size": [
          4,
          4
        ]
      },
      {
        "type": "flatten"
      },
      {
        "type": "linear",
        "out_features": 256
      },
      {
        "type": "relu"
      },
      {
        "type": "dropout",
        "p": 0.4
      },
      {
        "type": "linear",
        "out_features": "num_classes"
      }
    ]
  }
}
