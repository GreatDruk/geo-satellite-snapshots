{
  "seed": 42,
  "notes": "FINAL corrected AGMFA HardShift, fresh ImageNet V2, fixed22/cosine22, no validation selection. Source paired D4 clean+mandatory hard+JS; target D4-only CE weight2, once per epoch, no oversampling. Splits=['train', 'val']. Train-only val reporting uses final epoch; train+val has no held-out val. No TTA/ensemble/test fitting; final checkpoint epoch22.",
  "data": {
    "raw_dir": "data/raw",
    "image_size": 256,
    "batch_size": 16,
    "num_workers": 2,
    "pin_memory": true,
    "normalization": {
      "mean": [
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225
      ]
    },
    "augmentation": {},
    "persistent_workers": true,
    "prefetch_factor": 2
  },
  "training": {
    "epochs": 22,
    "log_every": 2,
    "device": "auto",
    "deterministic": true,
    "deterministic_warn_only": true,
    "optimizer": {
      "name": "adamw",
      "lr": 0.0005,
      "backbone_lr": 5e-05,
      "head_lr": 0.0005,
      "weight_decay": 0.001
    },
    "scheduler": {
      "name": "cosine",
      "T_max": 22,
      "eta_min": 1e-06
    },
    "loss": {
      "name": "cross_entropy",
      "label_smoothing": 0.0
    },
    "hard_target_shift": {
      "clean_ce_weight": 0.5,
      "hard_ce_weight": 0.5,
      "js_weight": 3.0,
      "temperature": 1.0
    }
  },
  "model": {
    "name": "resnet50_agmfa",
    "pretrained": true,
    "weights": "IMAGENET1K_V2",
    "mode": "partial",
    "head_dropout": 0.3,
    "freeze_bn": true,
    "warmup_epochs": 3,
    "unfreeze_blocks": [
      "layer3",
      "layer4"
    ],
    "agmfa": {
      "attention_reduction": 16,
      "fusion_channels": 512,
      "normalization": "group_norm",
      "norm_groups": 32,
      "attention_source": "conv2"
    }
  },
  "exp_id": "resnet50_agmfa_hardshift_final_train_val_001",
  "final_hardshift": {
    "training_splits": [
      "train",
      "val"
    ],
    "target_weight": 2.0,
    "checkpoint_selection": "fixed_last_epoch",
    "expected_counts": {
      "train": 4999,
      "val": 699
    }
  }
}
