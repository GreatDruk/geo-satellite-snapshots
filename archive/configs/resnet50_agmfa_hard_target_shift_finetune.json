{
  "seed": 42,
  "notes": "Hard Target Shift C: shared uniform D4, paired clean+mandatory hard view, six deterministic cyclic profiles, CE0.5+CE0.5+JS3 (T1), no clean mixing/AugMix/MixStyle. 12 epochs, frozen backbone BN, seed42; train only, original deterministic val, no TTA/test. best.pt=best_accuracy.pt; also best_loss.pt. Untrained candidate.",
  "data": {
    "raw_dir": "data/raw",
    "image_size": 256,
    "batch_size": 16,
    "num_workers": 2,
    "pin_memory": true,
    "normalization": {
      "mean": [
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225
      ]
    },
    "augmentation": {},
    "persistent_workers": true,
    "prefetch_factor": 2
  },
  "training": {
    "epochs": 12,
    "log_every": 2,
    "device": "auto",
    "deterministic": true,
    "deterministic_warn_only": true,
    "optimizer": {
      "name": "adamw",
      "lr": 5e-05,
      "backbone_lr": 1e-05,
      "head_lr": 5e-05,
      "weight_decay": 0.001
    },
    "scheduler": {
      "name": "cosine",
      "T_max": 12,
      "eta_min": 1e-06
    },
    "loss": {
      "name": "cross_entropy",
      "label_smoothing": 0.0
    },
    "hard_target_shift": {
      "clean_ce_weight": 0.5,
      "hard_ce_weight": 0.5,
      "js_weight": 3.0,
      "temperature": 1.0
    },
    "initialize_from": "artifacts/models/resnet50_agmfa_robust_augmix_fixed_001/best.pt"
  },
  "model": {
    "name": "resnet50_agmfa",
    "pretrained": true,
    "weights": "IMAGENET1K_V2",
    "mode": "partial",
    "head_dropout": 0.3,
    "freeze_bn": true,
    "warmup_epochs": 0,
    "unfreeze_blocks": [
      "layer2",
      "layer3",
      "layer4"
    ],
    "agmfa": {
      "attention_reduction": 16,
      "fusion_channels": 512,
      "normalization": "group_norm",
      "norm_groups": 32,
      "attention_source": "conv2"
    }
  },
  "exp_id": "resnet50_agmfa_hard_target_shift_finetune_001"
}
