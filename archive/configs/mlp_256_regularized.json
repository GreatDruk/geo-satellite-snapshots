{
  "seed": 42,
  "notes": "Native-resolution MLP; large dense input regularized with dropout; same no-augmentation protocol as mlp_128_wide, but widths also differ; untested candidate.",
  "data": {
    "raw_dir": "data/raw",
    "image_size": 256,
    "batch_size": 64,
    "num_workers": 2,
    "pin_memory": true,
    "normalization": {
      "mean": [
        0.5,
        0.5,
        0.5
      ],
      "std": [
        0.5,
        0.5,
        0.5
      ]
    },
    "augmentation": {}
  },
  "training": {
    "epochs": 40,
    "log_every": 5,
    "device": "auto",
    "deterministic": true,
    "optimizer": {
      "name": "adamw",
      "lr": 0.0002,
      "weight_decay": 0.01,
      "betas": [
        0.9,
        0.999
      ]
    },
    "scheduler": {
      "name": "cosine",
      "T_max": 40,
      "eta_min": 5e-06
    }
  },
  "model": {
    "name": "mlp",
    "pretrained": false,
    "layers": [
      {
        "type": "flatten"
      },
      {
        "type": "linear",
        "out_features": 256
      },
      {
        "type": "relu"
      },
      {
        "type": "dropout",
        "p": 0.45
      },
      {
        "type": "linear",
        "out_features": 128
      },
      {
        "type": "relu"
      },
      {
        "type": "dropout",
        "p": 0.3
      },
      {
        "type": "linear",
        "out_features": "num_classes"
      }
    ]
  }
}
