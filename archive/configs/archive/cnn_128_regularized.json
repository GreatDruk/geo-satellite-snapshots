{
  "seed": 42,
  "notes": "Higher-resolution CNN from scratch; doubled convolutions at lower resolutions; modest rotation introduces black borders in the current PIL transform; untested candidate.",
  "data": {
    "raw_dir": "data/raw",
    "image_size": 128,
    "batch_size": 64,
    "num_workers": 2,
    "pin_memory": true,
    "normalization": {
      "mean": [
        0.5,
        0.5,
        0.5
      ],
      "std": [
        0.5,
        0.5,
        0.5
      ]
    },
    "augmentation": {
      "horizontal_flip": 0.5,
      "vertical_flip": 0.5,
      "rotation_degrees": 15
    },
    "persistent_workers": true,
    "prefetch_factor": 2
  },
  "training": {
    "epochs": 30,
    "log_every": 2,
    "device": "auto",
    "deterministic": true,
    "optimizer": {
      "name": "adamw",
      "lr": 0.0007,
      "weight_decay": 0.01,
      "betas": [
        0.9,
        0.999
      ]
    },
    "scheduler": {
      "name": "cosine",
      "T_max": 30,
      "eta_min": 1e-05
    },
    "deterministic_warn_only": true
  },
  "model": {
    "name": "cnn",
    "pretrained": false,
    "layers": [
      {
        "type": "conv2d",
        "out_channels": 24,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "max_pool2d",
        "kernel_size": 2
      },
      {
        "type": "conv2d",
        "out_channels": 48,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "conv2d",
        "out_channels": 48,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "max_pool2d",
        "kernel_size": 2
      },
      {
        "type": "conv2d",
        "out_channels": 96,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "conv2d",
        "out_channels": 96,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "max_pool2d",
        "kernel_size": 2
      },
      {
        "type": "conv2d",
        "out_channels": 160,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "max_pool2d",
        "kernel_size": 2
      },
      {
        "type": "adaptive_avg_pool2d",
        "output_size": [
          2,
          2
        ]
      },
      {
        "type": "flatten"
      },
      {
        "type": "linear",
        "out_features": 192
      },
      {
        "type": "relu"
      },
      {
        "type": "dropout",
        "p": 0.4
      },
      {
        "type": "linear",
        "out_features": "num_classes"
      }
    ]
  }
}
