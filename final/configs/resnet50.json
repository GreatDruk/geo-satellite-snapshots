{
  "seed": 42,
  "notes": "Fresh ImageNet V2; fixed 25 epochs on train+val; last epoch only.",
  "data": {
    "raw_dir": "data/raw",
    "image_size": 256,
    "batch_size": 16,
    "num_workers": 2,
    "pin_memory": true,
    "normalization": {
      "mean": [
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225
      ]
    },
    "augmentation": {},
    "persistent_workers": true,
    "prefetch_factor": 2
  },
  "training": {
    "epochs": 25,
    "log_every": 1,
    "device": "auto",
    "deterministic": true,
    "deterministic_warn_only": true,
    "optimizer": {
      "name": "adamw",
      "lr": 0.0005,
      "backbone_lr": 5e-05,
      "head_lr": 0.0005,
      "weight_decay": 0.001
    },
    "scheduler": {
      "name": "cosine",
      "T_max": 25,
      "eta_min": 1e-06
    },
    "loss": {
      "name": "cross_entropy",
      "label_smoothing": 0.0
    },
    "hard_target_shift": {
      "clean_ce_weight": 0.5,
      "hard_ce_weight": 0.5,
      "js_weight": 3.0,
      "temperature": 1.0
    },
    "selection": "fixed_last_epoch",
    "target_weight": 2.0
  },
  "model": {
    "name": "resnet50",
    "pretrained": true,
    "weights": "IMAGENET1K_V2",
    "mode": "partial",
    "head_dropout": 0.3,
    "freeze_bn": true,
    "warmup_epochs": 3,
    "unfreeze_blocks": [
      "layer3",
      "layer4"
    ]
  },
  "fit_counts": {
    "train": 4999,
    "val": 699
  }
}
