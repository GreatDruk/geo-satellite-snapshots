{
  "seed": 42,
  "notes": "",
  "data": {
    "raw_dir": "data/raw",
    "image_size": 256,
    "batch_size": 64,
    "num_workers": 0,
    "pin_memory": false,
    "normalization": {
      "mean": [
        0.5,
        0.5,
        0.5
      ],
      "std": [
        0.5,
        0.5,
        0.5
      ]
    },
    "augmentation": {}
  },
  "training": {
    "epochs": 40,
    "log_every": 4,
    "device": "auto",
    "deterministic": true,
    "scheduler": null,
    "optimizer": {
      "name": "adam",
      "lr": 0.001,
      "weight_decay": 0.0001
    },
    "deterministic_warn_only": true
  },
  "model": {
    "name": "cnn",
    "pretrained": false,
    "layers": [
      {
        "type": "conv2d",
        "out_channels": 16,
        "kernel_size": 3,
        "padding": 1
      },
      {
        "type": "relu"
      },
      {
        "type": "max_pool2d",
        "kernel_size": 2
      },
      {
        "type": "conv2d",
        "out_channels": 32,
        "kernel_size": 3,
        "padding": 1
      },
      {
        "type": "relu"
      },
      {
        "type": "max_pool2d",
        "kernel_size": 2
      },
      {
        "type": "conv2d",
        "out_channels": 64,
        "kernel_size": 3,
        "padding": 1
      },
      {
        "type": "relu"
      },
      {
        "type": "adaptive_avg_pool2d",
        "output_size": [
          4,
          4
        ]
      },
      {
        "type": "flatten"
      },
      {
        "type": "linear",
        "out_features": 128
      },
      {
        "type": "relu"
      },
      {
        "type": "dropout",
        "p": 0.3
      },
      {
        "type": "linear",
        "out_features": "num_classes"
      }
    ]
  }
}
