{
  "seed": 42,
  "notes": "Matched ResNet50 full versus partial control: flips, weights, epochs, optimizer/LRs and frozen BN statistics unchanged; first three epochs head-only; untested candidate.",
  "data": {
    "raw_dir": "data/raw",
    "image_size": 256,
    "batch_size": 32,
    "num_workers": 2,
    "pin_memory": true,
    "normalization": {
      "mean": [
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225
      ]
    },
    "augmentation": {
      "horizontal_flip": 0.5,
      "vertical_flip": 0.5
    },
    "persistent_workers": true,
    "prefetch_factor": 2
  },
  "training": {
    "epochs": 25,
    "log_every": 2,
    "device": "auto",
    "deterministic": true,
    "deterministic_warn_only": true,
    "optimizer": {
      "name": "adamw",
      "lr": 0.0005,
      "backbone_lr": 5e-05,
      "head_lr": 0.0005,
      "weight_decay": 0.001
    },
    "scheduler": {
      "name": "cosine",
      "T_max": 25,
      "eta_min": 1e-06
    }
  },
  "model": {
    "name": "resnet50",
    "pretrained": true,
    "weights": "IMAGENET1K_V2",
    "mode": "full",
    "head_dropout": 0.3,
    "freeze_bn": true,
    "warmup_epochs": 3
  }
}
