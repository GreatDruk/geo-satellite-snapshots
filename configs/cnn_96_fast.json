{
  "seed": 42,
  "notes": "Compact CNN from scratch, four Conv-BN-ReLU blocks, moderate flips; first CNN to run under a limited GPU budget; untested candidate.",
  "data": {
    "raw_dir": "data/raw",
    "image_size": 96,
    "batch_size": 64,
    "num_workers": 2,
    "pin_memory": true,
    "normalization": {
      "mean": [
        0.5,
        0.5,
        0.5
      ],
      "std": [
        0.5,
        0.5,
        0.5
      ]
    },
    "augmentation": {
      "horizontal_flip": 0.5,
      "vertical_flip": 0.5
    }
  },
  "training": {
    "epochs": 24,
    "log_every": 2,
    "device": "auto",
    "deterministic": true,
    "optimizer": {
      "name": "adamw",
      "lr": 0.001,
      "weight_decay": 0.005,
      "betas": [
        0.9,
        0.999
      ]
    },
    "scheduler": {
      "name": "cosine",
      "T_max": 24,
      "eta_min": 1e-05
    },
    "deterministic_warn_only": true
  },
  "model": {
    "name": "cnn",
    "pretrained": false,
    "layers": [
      {
        "type": "conv2d",
        "out_channels": 16,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "max_pool2d",
        "kernel_size": 2
      },
      {
        "type": "conv2d",
        "out_channels": 32,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "max_pool2d",
        "kernel_size": 2
      },
      {
        "type": "conv2d",
        "out_channels": 64,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "max_pool2d",
        "kernel_size": 2
      },
      {
        "type": "conv2d",
        "out_channels": 128,
        "kernel_size": 3,
        "padding": 1,
        "bias": false
      },
      {
        "type": "batch_norm2d"
      },
      {
        "type": "relu"
      },
      {
        "type": "max_pool2d",
        "kernel_size": 2
      },
      {
        "type": "adaptive_avg_pool2d",
        "output_size": [
          2,
          2
        ]
      },
      {
        "type": "flatten"
      },
      {
        "type": "linear",
        "out_features": 128
      },
      {
        "type": "relu"
      },
      {
        "type": "dropout",
        "p": 0.3
      },
      {
        "type": "linear",
        "out_features": "num_classes"
      }
    ]
  }
}
