{
  "seed": 42,
  "notes": "One robust domain-shift recipe, no grid: ResNet50 V2 LGFFE + uniform D4 + AugMix width3, random depth1-3, Dirichlet/Beta alpha1, custom robust photo/corruption pool, no JSD; replaces all previous stronger photometric/corruption transforms. MixStyle after layer1/layer2, train-only p0.5 alpha0.1. Partial layer3/layer4, frozen BN, head warmup3, ordinary CE. Train only; val deterministic, no test access. Fresh ImageNet initialization; no reuse of fitted LGFFE weights. Untested training candidate.",
  "data": {
    "raw_dir": "data/raw",
    "image_size": 256,
    "batch_size": 32,
    "num_workers": 2,
    "pin_memory": true,
    "normalization": {
      "mean": [
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225
      ]
    },
    "augmentation": {
      "random_d4": true,
      "robust_augmix": {
        "width": 3,
        "depth": [
          1,
          3
        ],
        "alpha": 1.0,
        "operations": {
          "brightness": {
            "range": [
              0.35,
              1.6
            ]
          },
          "contrast": {
            "range": [
              0.4,
              1.6
            ]
          },
          "gamma": {
            "range": [
              0.45,
              2.2
            ]
          },
          "saturation": {
            "range": [
              0.0,
              1.8
            ]
          },
          "hue": {
            "range": [
              -0.08,
              0.08
            ]
          },
          "grayscale": {
            "range": [
              0.4,
              1.0
            ]
          },
          "white_balance": {
            "range": [
              0.6,
              1.4
            ]
          },
          "autocontrast": {},
          "equalize": {},
          "solarize": {
            "range": [
              64,
              192
            ],
            "weight": 0.15
          },
          "invert": {
            "weight": 0.1
          },
          "gaussian_blur": {
            "range": [
              0.4,
              2.5
            ]
          },
          "motion_blur": {
            "range": [
              3,
              13
            ]
          },
          "defocus_blur": {
            "range": [
              1,
              4
            ]
          },
          "resolution_degradation": {
            "range": [
              0.25,
              0.8
            ]
          },
          "jpeg_compression": {
            "range": [
              25,
              90
            ]
          },
          "gaussian_noise": {
            "range": [
              0.005,
              0.06
            ]
          },
          "shot_noise": {
            "range": [
              20,
              120
            ]
          }
        }
      }
    },
    "persistent_workers": true,
    "prefetch_factor": 2
  },
  "training": {
    "epochs": 25,
    "log_every": 2,
    "device": "auto",
    "deterministic": true,
    "deterministic_warn_only": true,
    "optimizer": {
      "name": "adamw",
      "lr": 0.0005,
      "backbone_lr": 5e-05,
      "head_lr": 0.0005,
      "weight_decay": 0.001
    },
    "scheduler": {
      "name": "cosine",
      "T_max": 25,
      "eta_min": 1e-06
    },
    "loss": {
      "name": "cross_entropy",
      "label_smoothing": 0.0
    }
  },
  "model": {
    "name": "resnet50_lgffe",
    "pretrained": true,
    "weights": "IMAGENET1K_V2",
    "mode": "partial",
    "head_dropout": 0.3,
    "freeze_bn": true,
    "warmup_epochs": 3,
    "unfreeze_blocks": [
      "layer3",
      "layer4"
    ],
    "lgffe": {
      "gru_hidden_size": 512,
      "head_hidden_size": 512
    },
    "mixstyle": {
      "p": 0.5,
      "alpha": 0.1,
      "after_blocks": [
        "layer1",
        "layer2"
      ]
    }
  },
  "exp_id": "resnet50_lgffe_robust_augmix_mixstyle_001"
}
